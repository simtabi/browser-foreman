          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The head you last saw (the workspace's ETag); a stale one answers 412"
          }
        ],
        "description": "Body: {parent, index?, kind, title, url?, note?}"
      }
    },
    "/api/v1/workspaces/{id}/nodes/{node}": {
      "patch": {
        "summary": "Change a title, URL or note",
        "tags": [
          "Bookmarks"
        ],
        "x-role": "editor",
        "responses": {
          "default": {
            "description": "JSON; errors are {\"error\": \"message\"}"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "node",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The head you last saw (the workspace's ETag); a stale one answers 412"
          }
        ],
        "description": "Body: {title?, url?, note?}"
      }
    },
    "/api/v1/workspaces/{id}/move": {
      "post": {
        "summary": "Move bookmarks and folders, in the order given",
        "tags": [
          "Bookmarks"
        ],
        "x-role": "editor",
        "responses": {
          "default": {
            "description": "JSON; errors are {\"error\": \"message\"}"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
