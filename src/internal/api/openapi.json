      "get": {
        "summary": "What is in the Trash, with where each came from",
        "tags": [
          "Trash"
        ],
        "x-role": "viewer",
        "responses": {
          "default": {
            "description": "JSON; errors are {\"error\": \"message\"}"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Move to the Trash",
        "tags": [
          "Trash"
        ],
        "x-role": "editor",
        "responses": {
          "default": {
            "description": "JSON; errors are {\"error\": \"message\"}"
          }
        },
