              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The head you last saw (the workspace's ETag); a stale one answers 412"
          }
        ],
        "description": "Body: {ids, reason?}"
      },
      "delete": {
        "summary": "Delete for good (?ids=a,b, or everything); undo still brings them back",
        "tags": [
          "Trash"
        ],
        "x-role": "editor",
        "responses": {
          "default": {
            "description": "JSON; errors are {\"error\": \"message\"}"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The head you last saw (the workspace's ETag); a stale one answers 412"
          }
        ]
