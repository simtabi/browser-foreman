# Browser Foreman's secrets and overrides. The app makes your .env from this file the first time it runs
# (browser-foreman config init); keep that copy private (it is created 0600).
#
# A variable left empty is not set: the config files (*.json beside this file) and the defaults apply.
# Variables set in the shell win over this file. The web page's Settings edits this file too, for the
# values that belong here, and never shows a secret back.

# The token the page and the command line use. Made for you by config init.
BROFO_API_TOKEN=

# AI jobs (suggested tags, duplicate verdicts): who answers them, and their keys.
BROFO_AI_PROVIDER=
BROFO_AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server and storage. These are usually set in config.json instead.
BROFO_SERVER_ADDR=
BROFO_SERVER_MODE=
BROFO_SERVER_OPEN=
BROFO_STORAGE_DRIVER=
BROFO_STORAGE_PATH=
BROFO_SESSION_TTL=
BROFO_WEBHOOK_TIMEOUT=
BROFO_WEBHOOK_ATTEMPTS=
BROFO_MCP=
BROFO_MCP_WRITES=
BROFO_SETTINGS_EDIT=
