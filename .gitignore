# Build output: one folder per OS; only the target list is tracked.
/build/*
!/build/targets.txt

# Web interface
/web/node_modules/
/web/dist/
# The web interface staged for embedding by `make web`; only the placeholder is tracked.
/src/internal/webui/dist/*
!/src/internal/webui/dist/.keep

# Secrets and personal data never belong here. The tool keeps them in ~/.config/browser-foreman and
# ~/.local/state/browser-foreman; these lines catch a copy made by mistake.
.env
.env.*
!.env.example
*.sqlite3
*.sqlite3-*
storage/
/public/
*.jsonl

# Python (legacy/)
__pycache__/
*.pyc
.venv/

# Editors and systems
.DS_Store
.idea/
.vscode/
